{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowHub Client",
  "version": "0.1.0",
  "identifier": "com.openclaw.flowhub.client",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlowHub Client",
        "width": 960,
        "height": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
