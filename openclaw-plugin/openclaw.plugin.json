{
  "id": "flowhub-openclaw",
  "name": "FlowHub OpenClaw Bridge",
  "description": "Expose a single FlowHub chat entrypoint plus fallback tools so an OpenClaw agent can handle onboarding, install guidance, workflow planning, and confirmation through FlowHub.",
  "version": "0.1.0",
  "skills": ["skills/flowhub-orchestrator"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiBaseUrl": {
        "type": "string",
        "minLength": 1
      },
      "apiKey": {
        "type": "string",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "default": 20000
      },
      "defaultExecutionMode": {
        "type": "string",
        "enum": ["remote", "local"],
        "default": "remote"
      },
      "defaultOutputFormat": {
        "type": "string",
        "enum": ["json", "csv", "xlsx", "pdf", "markdown"],
        "default": "markdown"
      }
    },
    "required": ["apiBaseUrl", "apiKey"]
  },
  "uiHints": {
    "apiBaseUrl": {
      "label": "FlowHub API Base URL",
      "placeholder": "http://127.0.0.1:8000/api/v1"
    },
    "apiKey": {
      "label": "FlowHub API Key",
      "sensitive": true
    },
    "timeoutMs": {
      "label": "Timeout (ms)"
    },
    "defaultExecutionMode": {
      "label": "Default Execution Mode"
    },
    "defaultOutputFormat": {
      "label": "Default Output Format"
    }
  }
}
